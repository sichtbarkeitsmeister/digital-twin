# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_SURVEY_MODEL=claude-sonnet-4-20250514

# Public base URL of the deployed app. Used for webhook URLs.
APP_BASE_URL=https://www.digital-twin-sbkm.de

# Jobs runner: shared secret between pg_cron and /api/jobs/run.
# Generate a long random string (e.g. `openssl rand -hex 32`).
# Also store the same value in Supabase: app_settings(key='jobs_worker_token').
JOBS_WORKER_TOKEN=

# n8n MCP (Settings > Instance-level MCP > Connection details > Access Token)
N8N_MCP_ACCESS_TOKEN=

# n8n REST API (Settings > n8n API) — used by mcp-n8n in Cursor
N8N_BASE_URL=https://sichtbarkeitsmeister.app.n8n.cloud
N8N_API_KEY=

# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

ANTHROPIC_API_KEY=your-anthropic-api-key
# Legacy override for action/generation model only:
ANTHROPIC_SURVEY_MODEL=claude-sonnet-4-6
# Cheaper model for chat/brainstorming and utility calls (titles, JSON repair):
ANTHROPIC_SURVEY_CHAT_MODEL=claude-haiku-4-5-20251001
# Sonnet for survey creation, edits, and folder/survey actions:
ANTHROPIC_SURVEY_ACTION_MODEL=claude-sonnet-4-6
# Prompt caching for static system instructions (default on; set 0 to disable):
ANTHROPIC_SURVEY_PROMPT_CACHE=1
# Multi-phase generation for large new surveys, 12+ steps (default on; set 0 to disable):
ANTHROPIC_SURVEY_MULTIPHASE=1

# Public base URL of the deployed app. n8n calls this for webhooks and for the
# chat tools, and `npm run dt:n8n:chat` bakes it into the n8n Code node.
# Must be publicly reachable — a localhost value would break the deployed
# workflow. For local n8n testing use a tunnel URL (e.g. ngrok).
APP_BASE_URL=https://www.digital-twin-sbkm.de

# Jobs runner: shared secret between pg_cron and /api/jobs/run.
# Generate a long random string (e.g. `openssl rand -hex 32`).
# Also store the same value in Supabase: app_settings(key='jobs_worker_token').
JOBS_WORKER_TOKEN=

# n8n MCP (Settings > Instance-level MCP > Connection details > Access Token)
N8N_MCP_ACCESS_TOKEN=

# n8n REST API (Settings > n8n API) — used by mcp-n8n in Cursor
N8N_BASE_URL=https://sichtbarkeitsmeister.app.n8n.cloud
N8N_API_KEY=

# DigitalTwin Portal (Phase 1+)
N8N_DT_CHAT_WEBHOOK=https://sichtbarkeitsmeister.app.n8n.cloud/webhook/dt-chat
N8N_DT_SEO_REPORT_WEBHOOK=https://sichtbarkeitsmeister.app.n8n.cloud/webhook/dt-seo-report
N8N_DT_GSC_URL_INSPECTION_WEBHOOK=https://sichtbarkeitsmeister.app.n8n.cloud/webhook/dt-gsc-url-inspection
# openssl rand -hex 32 — shared by Next.js + n8n (build-system-prompt, SEO callbacks)
DT_INTERNAL_WEBHOOK_SECRET=
# APP_BASE_URL is defined once above — do not repeat it here. A second entry
# wins over the first one and would point the n8n workflow at localhost.
ANTHROPIC_DT_PERSONA_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DT_SEO_MODEL=claude-sonnet-4-6
ANTHROPIC_DT_TEAM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_DT_GHOST_MODEL=claude-haiku-4-5-20251001
# Survey → avatar generation (optional overrides)
# Default: Sonnet + 64k tokens via Anthropic Message Batches (async; bypasses Vercel 5‑min limit).
# ANTHROPIC_DT_SURVEY_MODEL=claude-sonnet-4-6
# ANTHROPIC_DT_SURVEY_MAX_TOKENS=64000
# ANTHROPIC_DT_SURVEY_TIMEOUT_MS=270000  # only for legacy sync/streaming path

# Phase 7 migration only — remove OLD_SUPABASE_SERVICE_ROLE_KEY after cutover
OLD_SUPABASE_URL=https://zijlepanidmvwxbuwldz.supabase.co
OLD_SUPABASE_SERVICE_ROLE_KEY=
# Platform admin user id used as invited_by for migration invites
DT_MIGRATION_INVITED_BY_USER_ID=
